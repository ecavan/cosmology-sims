+/**
+ * Running vacuum: transfer rate vacuum -> CDM per ln a, S = d rho_cdm/d ln a + 3 rho_cdm = H0^2 [3 nu A a^{-3(1-nu)} + k Om_r a^{-4}].
+ */
+double background_rvm_source(struct background * pba, double a) {
+  double nu = pba->rvm_nu, k = 4.*nu/(1.+3.*nu)*pba->rvm_rad, Om_r = pba->Omega0_g + pba->Omega0_ur;
+  double A = pba->Omega0_cdm + pba->Omega0_b + k*Om_r;
+  if (nu == 0.) return 0.;
+  if (pba->rvm_flip_z2 > 0.) {
+    double rho_m, rho_vac, src;
+    background_rvm_flip(pba,a,&rho_m,&rho_vac,&src);
+    return src;
+  }
+  return pow(pba->H0,2) * (3.*nu*A*pow(a,-3.*(1.-nu)) + k*Om_r/pow(a,4));
+}
+
+/**
+ * Flipped RVM: total matter ~ a^{-3(1-nu)} below z1, a^{-3(1+nu)} for z1<z<z2, a^{-3} above z2, continuous at the
+ * switches; in each segment rho_vac - rho_vac(a_e) = ((3-n)/n)(rho_m - rho_m(a_e)); source S = (3-n) rho_m per ln a.
+ */
+void background_rvm_flip(struct background * pba, double a, double * rho_m, double * rho_vac, double * source) {
+  double nu = pba->rvm_nu, H02 = pow(pba->H0,2);
+  double a1 = 1./(1.+pba->rvm_flip_z1), a2 = 1./(1.+pba->rvm_flip_z2);
+  double n1 = 3.*(1.-nu), n2 = 3.*(1.+nu);
+  double m0 = pba->Omega0_cdm + pba->Omega0_b, v0 = pba->Omega0_lambda;
+  double m1 = m0*pow(a1,-n1), v1 = v0 + (3.-n1)/n1*(m1-m0);
+  double m2 = m1*pow(a2/a1,-n2), v2 = v1 + (3.-n2)/n2*(m2-m1);
+  double m, v, n;
+  if (a >= a1) { m = m0*pow(a,-n1); v = v0 + (3.-n1)/n1*(m-m0); n = n1; }
+  else if (a >= a2) { m = m1*pow(a/a1,-n2); v = v1 + (3.-n2)/n2*(m-m1); n = n2; }
+  else { m = m2*pow(a/a2,-3.); v = v2; n = 3.; }
+  *rho_m = H02*m; *rho_vac = H02*v; *source = (3.-n)*H02*m;
+}
+
 int background_w_fld(
                      struct background * pba,
                      double a,
